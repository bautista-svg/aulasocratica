# Copiá este archivo a .env para desarrollo local.
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgres://aula:aula_dev_pw@127.0.0.1:54390/aula
DATA_DIR=./data
PUBLIC_URL=http://localhost:5173
TRUST_PROXY=false
# Claude (Anthropic). Si la key no está asociada a un workspace, completá ANTHROPIC_WORKSPACE_ID (wrkspc_…).
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
AI_MODEL=claude-haiku-5-5
AI_DAILY_USD_PER_WORKSPACE=3
AI_DAILY_USD_GLOBAL=40
AI_DAILY_REPLIES_PER_STUDENT=150
# Contraseña del panel /admin (vacía = panel deshabilitado). Mínimo 16 caracteres en producción.
ADMIN_PASSWORD=
LOG_LEVEL=info
