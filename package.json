{
  "name": "aula-socratica",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aula Socrática: tutor socrático con IA para docentes y estudiantes.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=src --env-file-if-exists=.env --import tsx src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@hono/node-server": "2.1.5",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfkit": "0.20.2",
    "postgres": "3.4.9",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/router-plugin": "1.168.47",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "clsx": "2.1.1",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "lighthouse": "13.5.0",
    "lucide-react": "1.60.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
